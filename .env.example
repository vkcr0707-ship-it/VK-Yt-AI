# Local runtime
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://user:password@host.example.com/database?sslmode=require

# AI / LLM
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# YouTube / Google
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3001/api/v1/production?action=oauth-callback

# TTS / voice
TTS_API_KEY=
TTS_VOICE_ID=

# Image generation
IMAGE_API_KEY=

# Web research / fact-checking
TAVILY_API_KEY=
WEB_SEARCH_API_KEY=

# App auth / security
SESSION_SECRET=

# Optional deployment
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional local/dev protection and storage capability reporting
RATE_LIMIT_REQUESTS=***
RATE_LIMIT_WINDOW_MS=***
MEDIA_STORAGE_ENDPOINT=***
MEDIA_STORAGE_TOKEN=***
WORKER_MODE=***
